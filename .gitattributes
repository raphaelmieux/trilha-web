# Normalise line endings on the way into git.
#
# The working copy lives on a Windows machine and files land with CRLF; every
# commit was reporting "CRLF will be replaced by LF" for a dozen files, which
# buried real warnings in noise and made `git status` after a fresh clone show
# the whole tree as modified.
* text=auto eol=lf

# Binary, never touched.
*.png binary
*.jpg binary
*.pdf binary
